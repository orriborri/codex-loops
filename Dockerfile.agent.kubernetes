# Build Dockerfile.agent first with a pinned CODEX_VERSION, then set
# BASE_AGENT_IMAGE to that image (and pin both base images by digest in production).
ARG BASE_AGENT_IMAGE=codex-loops-agent:local
FROM python:3.12-slim-bookworm AS python
FROM ${BASE_AGENT_IMAGE}
USER root
# Bookworm's system Python can lack PEP 706's data filter. Copy the supported
# Python runtime into the already-provisioned agent without changing Docker mode.
COPY --from=python /usr/local /usr/local
RUN ldconfig && python3 -c 'import tarfile, ssl, bz2, lzma; assert hasattr(tarfile, "data_filter")'
USER node
WORKDIR /repo
