FROM python:3.12-slim-bookworm
ARG KUBECTL_VERSION
ARG KUBECTL_SHA256
ARG TARGETARCH
RUN test -n "$KUBECTL_VERSION" && test -n "$KUBECTL_SHA256" && test -n "$TARGETARCH" \
    && apt-get update && apt-get install -y --no-install-recommends git curl ca-certificates \
    && curl --fail --silent --show-error --location \
      "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${TARGETARCH}/kubectl" -o /usr/local/bin/kubectl \
    && echo "${KUBECTL_SHA256}  /usr/local/bin/kubectl" | sha256sum -c - \
    && chmod 755 /usr/local/bin/kubectl \
    && apt-get purge -y curl && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY loop.py workflow.py telemetry.py reviewing.py baseline.py kube_runner.py /app/
ENTRYPOINT ["python", "-u", "/app/loop.py"]
