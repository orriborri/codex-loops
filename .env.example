GITHUB_REPOSITORY=your-user/your-repo
BASE_BRANCH=main
# Must be an absolute path that exists on your Docker host. Use a dedicated runner.
WORK_ROOT=/opt/codex-loops/work
# Resolve a published version (npm view @openai/codex version), then pin it here.
CODEX_VERSION=
# codex uses your saved ChatGPT/Codex sign-in; api uses usage-based billing.
AUTH_MODE=codex
CODEX_AUTH_VOLUME=codex-loops-auth
# Only needed with AUTH_MODE=api.
OPENAI_API_KEY=
IMPLEMENT_GITHUB_TOKEN=
REVIEW_GITHUB_TOKEN=
MERGE_GITHUB_TOKEN=
IMPROVE_GITHUB_TOKEN=
# Exact GitHub login of the identity behind REVIEW_GITHUB_TOKEN.
REVIEWER_LOGIN=your-review-bot
# Exact check run names or commit status contexts, comma separated.
REQUIRED_CHECKS=test,lint
IMPLEMENT_MODEL=
REVIEW_MODEL=
MAX_FIX_ATTEMPTS=5
JOB_TIMEOUT_SECONDS=1800
POLL_SECONDS=30
AUTO_MERGE=false
AUTO_QUEUE_IMPROVEMENTS=false
MAX_OPEN_IMPROVEMENTS=3
