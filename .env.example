GITHUB_REPOSITORY=your-user/your-repo
BASE_BRANCH=main
# Must be an absolute path that exists on your Docker host. Use a dedicated runner.
WORK_ROOT=/opt/codex-loops/work
# Resolve a published version (npm view @openai/codex version), then pin it here.
CODEX_VERSION=
# codex uses your saved ChatGPT/Codex sign-in; api uses usage-based billing.
AUTH_MODE=codex
CODEX_AUTH_VOLUME=codex-loops-auth
# Only needed with AUTH_MODE=api.
OPENAI_API_KEY=
IMPLEMENT_GITHUB_TOKEN=
REVIEW_GITHUB_TOKEN=
MERGE_GITHUB_TOKEN=
IMPROVE_GITHUB_TOKEN=
# Exact GitHub login of the identity behind REVIEW_GITHUB_TOKEN.
REVIEWER_LOGIN=your-review-bot
# Exact check run names or commit status contexts, comma separated.
REQUIRED_CHECKS=test,lint
IMPLEMENT_MODEL=
# Prefer a different model for independent review; blank uses the pinned CLI default.
REVIEW_MODEL=
# Optional improvement job override; blank falls back to REVIEW_MODEL.
IMPROVE_MODEL=
MAX_FIX_ATTEMPTS=5
JOB_TIMEOUT_SECONDS=1800
POLL_SECONDS=30
AUTO_MERGE=false
AUTO_QUEUE_IMPROVEMENTS=false
MAX_OPEN_IMPROVEMENTS=3


# Optional controller-level Opik metadata export. Disabled until you choose an endpoint.
OPIK_ENABLED=false
# Self-hosted example: http://opik.your-lan:5173/api (reachable from controllers).
# Cloud: https://www.comet.com/opik/api; also set API key and workspace.
OPIK_URL_OVERRIDE=
OPIK_PROJECT_NAME=codex-loops
OPIK_WORKSPACE=
OPIK_API_KEY=
OPIK_TIMEOUT_SECONDS=2
OPIK_MAX_PENDING=10000

# Small-task/readiness and risk policy. Existing built-in high-risk paths cannot be lowered.
MAX_GOAL_CHARS=8000
MAX_CHANGE_LINES=300
HIGH_RISK_PATHS=
# Comma-separated GitHub user logins allowed to approve high-risk merges (also require repo write).
RISK_APPROVERS=
# Optional trusted project test command. Both revisions must write JUnit XML to /out/tests.xml.
# Example for a Python test image: python -m pytest --junitxml=/out/tests.xml
BASELINE_TEST_COMMAND=
BASELINE_TIMEOUT_SECONDS=600
